<header class="site-header">
  <div class="wrap header-inner">
    <a class="wordmark" href="/" {% if page.url == "/" %}aria-current="page"{% endif %}>
      <svg class="mark" viewBox="0 0 396 288" aria-hidden="true" focusable="false"><path fill="currentColor" d="M252,0H18A18,18,0,0,0,0,18V270a18,18,0,0,0,18,18H219.73a9,9,0,0,0,6.36-15.36l-51.36-51.37A18,18,0,0,0,162,216H81a9,9,0,0,1-9-9V81a9,9,0,0,1,9-9H251c39.52,0,72.42,31.44,73,71a72,72,0,0,1-42.15,66.47,9.05,9.05,0,0,0-2.51,14.62L319,263.68a9,9,0,0,0,11.28,1.18A143.82,143.82,0,0,0,396,144h0A144,144,0,0,0,252,0Z"/></svg>
      <span>Ryan Deverman</span>
    </a>
    <nav aria-label="Main">
      <ul class="nav">
        {%- for item in site.nav %}
        <li><a href="{{ item.url }}"{% if page.url == item.url or (item.url != "/" and page.url.startsWith(item.url)) %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endfor %}
        <li><a class="nav-resume" href="{{ site.resume }}">Resume <span class="visually-hidden">(PDF)</span></a></li>
      </ul>
    </nav>
  </div>
</header>
